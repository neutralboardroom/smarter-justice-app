{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarterjustice.com/schemas/product-deployment.schema.json",
  "title": "Smarter Justice portfolio product deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "productName",
    "repository",
    "runtime",
    "commands",
    "health",
    "localization",
    "dataContinuity",
    "sensitiveCapabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "productName": { "type": "string", "minLength": 3, "maxLength": 120 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": { "type": "string", "pattern": "^(22|24)\\.x$" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "test", "start"],
      "properties": {
        "install": { "type": "string", "minLength": 3 },
        "test": { "type": "string", "minLength": 3 },
        "build": { "type": "string" },
        "migrate": { "type": "string" },
        "start": { "type": "string", "minLength": 3 },
        "spanishCheck": { "type": "string" },
        "dataContinuityCheck": { "type": "string" },
        "securityCheck": { "type": "string" },
        "releaseCheck": { "type": "string" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicBaseUrlVariable", "paths", "expectedProductName"],
      "properties": {
        "publicBaseUrlVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        },
        "expectedProductName": { "type": "string", "minLength": 3 }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredLocales", "toggleRequired", "criticalJourneyReceiptRequired"],
      "properties": {
        "requiredLocales": {
          "type": "array",
          "const": ["en", "es"]
        },
        "toggleRequired": { "const": true },
        "criticalJourneyReceiptRequired": { "const": true }
      }
    },
    "dataContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistentStorageRequired", "backupReceiptRequired", "migrationClassRequired", "rollbackMustPreserveNewData"],
      "properties": {
        "persistentStorageRequired": { "const": true },
        "backupReceiptRequired": { "const": true },
        "migrationClassRequired": { "const": true },
        "rollbackMustPreserveNewData": { "const": true }
      }
    },
    "sensitiveCapabilities": {
      "type": "object",
      "additionalProperties": { "enum": ["CLOSED", "VERIFIED_OPEN"] }
    }
  }
}
