{
  "schemaVersion": 1,
  "productId": "smarter-justice",
  "productName": "Smarter Justice",
  "repository": "neutralboardroom/smarter-justice-app",
  "runtime": {
    "node": "22.x"
  },
  "commands": {
    "install": "npm ci --no-audit",
    "test": "npm test",
    "build": "npm run build --if-present",
    "migrate": "npm run migrate",
    "start": "npm start",
    "spanishCheck": "node scripts/test-spanish-owner-rule.js",
    "dataContinuityCheck": "node scripts/test-data-continuity-owner-rule.js",
    "securityCheck": "npm run test:security",
    "releaseCheck": "npm run deployment:validate"
  },
  "health": {
    "publicBaseUrlVariable": "PUBLIC_BASE_URL",
    "paths": ["/health", "/livez"],
    "expectedProductName": "Smarter Justice"
  },
  "localization": {
    "requiredLocales": ["en", "es"],
    "toggleRequired": true,
    "criticalJourneyReceiptRequired": true
  },
  "dataContinuity": {
    "persistentStorageRequired": true,
    "backupReceiptRequired": true,
    "migrationClassRequired": true,
    "rollbackMustPreserveNewData": true
  },
  "sensitiveCapabilities": {
    "payments": "CLOSED",
    "confidentialUploads": "CLOSED",
    "professionalHandoff": "CLOSED",
    "externalAI": "CLOSED"
  }
}
