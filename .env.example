# Smarter Justice v1.7.83 environment example — all sensitive gates fail closed
APP_BASE_URL=https://smarterjustice.com
PORT=3000
OWNER_NOTIFICATION_EMAIL=

# Owner account bootstrap. Set both values for the first production start, sign in,
# enable authenticator MFA, save the recovery codes securely, then remove both
# bootstrap values after the account is durably stored in PostgreSQL.
OWNER_ACCOUNT_NAME=Smarter Justice Owner
OWNER_ACCOUNT_EMAIL=
OWNER_ACCOUNT_PASSWORD=
OWNER_SESSION_HOURS=8

# Legacy migration access. Keep disabled in production. A token may be used only
# for local/test migration while the owner account is being introduced.
ALLOW_LEGACY_OWNER_TOKEN=false
OWNER_CONTROL_CENTER_TOKEN=
PORTAL_RULES_API_TOKEN=replace-with-a-separate-long-approved-portal-rules-token
ADMIN_TOKEN=replace-with-a-separate-long-staff-admin-token
# Keep false so admin tokens are sent in a request header, not placed in browser URLs or logs.
ALLOW_ADMIN_TOKEN_QUERY=false
# Reserved for future named staff accounts. The current restricted team session is derived from ADMIN_TOKEN.
STAFF_SIGNUP_CODE=
STAFF_SESSION_HOURS=8
PROFESSIONAL_SESSION_DAYS=14
CONTINUATION_TOKEN_DAYS=180
TRUST_PROXY=false
CSRF_ALLOWED_ORIGINS=

# Production persistence is fail-closed. Sensitive writes are blocked in production
# unless DATABASE_URL is configured and healthy. Uploads additionally require a
# durable private disk. Local JSON remains available only for development and tests.
# When RENDER_DISK_MOUNT_PATH is present, it takes precedence over SMARTER_JUSTICE_STORAGE_DIR.
SMARTER_JUSTICE_STORAGE_DIR=./storage
RENDER_DISK_MOUNT_PATH=
DATABASE_URL=
PGSSLMODE=require
PG_CONNECT_TIMEOUT_MS=5000
MAX_UPLOADS_PER_REQUEST=6
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.txt,.csv,.doc,.docx,.rtf,.eml,.msg
ALLOWED_UPLOAD_MIME_PREFIXES=application/pdf,image/,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument,application/rtf,message/rfc822,application/octet-stream
RATE_LIMIT_MAX=80
RATE_LIMIT_WINDOW_MS=600000
BODY_LIMIT_BYTES=14680064

# SMTP is required for live professional password recovery and transactional messages.
# Without SMTP, non-production notifications remain in storage/notifications.json.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stop Sign Project public-service feature. These public defaults may be overridden after destination and artwork review.
STOP_SIGN_PROJECT_DESTINATION_VERIFIED=false
STOP_DOMESTIC_VIOLENCE_URL=
PORTAL_DOMESTIC_VIOLENCE_SUPPORT_URL=
STOP_DOMESTIC_VIOLENCE_ARTWORK_PATH=/images/stop-sign-project.png

# Optional live chat. If unset, built-in help launcher links to Contact.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# Public Human Review Specialist charges remain fail-closed until every owner, policy,
# security, email, webhook, support, and refund gate is complete.
PUBLIC_PAID_SERVICES_ENABLED=false
SENSITIVE_TRAFFIC_APPROVED=false
PROFESSIONAL_PILOT_ACTIVATION_APPROVED=false

# Stripe Checkout + signed webhook foundation. Keep the controlled professional pilot
# paused until test-mode checkout, payment, renewal, failure, cancellation, and refund
# evidence is complete and the owner has deliberately opened the pilot controls.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_STARTER_REVIEW_PRICE_ID=
STRIPE_NOTICE_REVIEW_PRICE_ID=
STRIPE_FORM_PREP_PRICE_ID=
STRIPE_PROFESSIONAL_REVIEW_PREP_PRICE_ID=
# Reserved for separately engaged professional-service work; these do not activate the
# Human Review Specialist checkout catalog.
STRIPE_TAX_REVIEW_PRICE_ID=
STRIPE_ATTORNEY_REVIEW_PRICE_ID=
STRIPE_PROFESSIONAL_REVIEW_PRICE_ID=

# OpenAI-only central AI gateway. Keep every flag dark until protected project billing,
# the central service-account key, deployment, mock/evaluation acceptance, and one
# controlled live smoke pass. Never put OPENAI_API_KEY in a portal, browser, CI, log,
# screenshot, release artifact, or chat.
OPENAI_AI_ENABLED=false
AI_GLOBAL_KILL_SWITCH=true
AI_COST_HARD_STOP=false
AI_ANONYMOUS_ENABLED=false
AI_PORTAL_SMARTER_JUSTICE_CENTRAL_ENABLED=true
AI_TOOL_SJ_STARTING_POINT_ENABLED=false
AI_TOOL_ESTATE_MISSING_INFORMATION_ENABLED=false
AI_TOOL_DIVORCE_TIMELINE_ENABLED=false
AI_TOOL_PERSONAL_INJURY_EVIDENCE_ENABLED=false
AI_TOOL_DOMESTIC_VIOLENCE_SAFE_PREP_ENABLED=false
AI_GATEWAY_CONTRACT_VERSION=sj-ai-gateway-v1.0.0
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_SERVICE_ACCOUNT_ID=
OPENAI_MODEL=gpt-5-mini
OPENAI_REQUEST_TIMEOUT_MS=12000
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_STORE_RESPONSES=false
AI_DAILY_REQUEST_HARD_STOP=250
AI_MONTHLY_ESTIMATED_USD_HARD_STOP=100
# JSON map of portal IDs to protected server-to-server credentials. Store only in
# the central protected secret environment, never in source or a browser.
AI_PORTAL_SERVICE_TOKENS_JSON={}

# Paid professional growth remains closed until counsel, disclosure, payment, support, and owner acceptance.
PROFESSIONAL_GROWTH_LAUNCH_APPROVED=false
LAUNCH_ATTORNEY_ADVERTISING_REVIEW_RECORDED=false
LAUNCH_ATTORNEY_ADVERTISING_REVIEW_REFERENCE=
LAUNCH_FEE_SHARING_REVIEW_RECORDED=false
LAUNCH_FEE_SHARING_REVIEW_REFERENCE=
LAUNCH_SPONSORED_DISCLOSURE_ACCEPTANCE_RECORDED=false
LAUNCH_SPONSORED_DISCLOSURE_REFERENCE=

# Domestic Violence Aid remains local/fail-closed until exact staging and owner approval.
PORTAL_DOMESTIC_VIOLENCE_AID_URL=
DOMESTIC_VIOLENCE_AID_DESTINATION_VERIFIED=false

# Optional detached immutable-final identity binding (never place secrets here)
SMARTER_JUSTICE_FINAL_ARTIFACT_RECEIPT=
SMARTER_JUSTICE_FINAL_ARTIFACT_PATH=
