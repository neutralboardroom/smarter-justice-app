{
  "schema_id": "SJP-PROVIDER-DISCOVERY-AUTHORIZATION-REQUEST-2026-08-02-V1",
  "releaseVersion": "1.7.72",
  "purpose": "Bind any read-only provider discovery to an exact current product artifact, explicit least-privilege scopes, a short authorization window, and a detached request digest before any provider metadata is read.",
  "initialCutoverScope": [
    "smarter-justice-central",
    "divorce-law-aid",
    "estate-law-aid",
    "personal-injury-law-aid",
    "domestic-violence-aid"
  ],
  "allowedRequestStates": [
    "EXACT_ARTIFACT_CURRENTNESS_REQUIRED",
    "OWNER_AUTHORIZATION_REQUIRED",
    "AUTHORIZED_READ_ONLY",
    "EXPIRED",
    "REVOKED",
    "COMPLETED"
  ],
  "allowedIdentityEvidenceStates": [
    "EXACT_CURRENT_CHAT_VERIFIED",
    "HISTORICAL_EXACT_NOT_CURRENT_CHAT_VERIFIED",
    "VERSION_FILENAME_ONLY",
    "MISSING"
  ],
  "requiredScopes": [
    "GITHUB_REPOSITORY_METADATA",
    "GITHUB_DEFAULT_BRANCH_COMMIT_TREE",
    "RENDER_WORKSPACE_SERVICE_METADATA",
    "DOMAIN_DNS_TLS_REDIRECT_METADATA",
    "REQUIRED_SECRET_PRESENCE_ONLY",
    "MIGRATION_CLASSIFICATION_METADATA",
    "ROLLBACK_CANDIDATE_METADATA"
  ],
  "forbiddenActions": [
    "READ_SECRET_VALUES",
    "WRITE_REPOSITORY",
    "CHANGE_BRANCH_OR_COMMIT",
    "CREATE_OR_TRIGGER_DEPLOYMENT",
    "CHANGE_RENDER_CONFIGURATION",
    "CHANGE_DNS_OR_TLS",
    "MUTATE_DATABASE",
    "CREATE_OR_CHANGE_WEBHOOK",
    "CHANGE_BILLING_OR_ENTITLEMENTS"
  ],
  "maximumAuthorizationWindowHours": 8,
  "receiptBindingFields": [
    "authorization_request_id",
    "authorization_request_digest",
    "product.id",
    "product.version",
    "product.artifact_name",
    "product.artifact_sha256",
    "product.artifact_size_bytes"
  ],
  "invariants": {
    "exactArtifactRequiredBeforeAuthorization": true,
    "currentChatVerificationRequiredForPortalArtifacts": true,
    "readOnly": true,
    "secretValuesForbidden": true,
    "writesForbidden": true,
    "deploymentRequestForbidden": true,
    "productionRequestForbidden": true,
    "authorizationDoesNotFreezeCohort": true,
    "authorizationDoesNotSelectCanary": true,
    "authorizationDoesNotAuthorizeDeployment": true
  }
}
