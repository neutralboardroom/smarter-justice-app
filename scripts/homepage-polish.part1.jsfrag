'use strict';

const fs = require('node:fs');
const path = require('node:path');

const applicationRoot = path.resolve(process.argv[2] || '.');

function read(rel) { return fs.readFileSync(path.join(applicationRoot, rel), 'utf8'); }
function write(rel, value) { fs.writeFileSync(path.join(applicationRoot, rel), value); }
function replaceExact(text, from, to, label) {
  if (!text.includes(from)) throw new Error(`homepage polish source mismatch: ${label}`);
  return text.replace(from, to);
}
function replaceRegex(text, regex, to, label) {
  if (!regex.test(text)) throw new Error(`homepage polish source mismatch: ${label}`);
  return text.replace(regex, to);
}

let home = read('public/index.html');
home = replaceExact(home, 'href="/styles.css"', 'href="/styles.css?v=1.7.98-homepage-polish-1"', 'homepage stylesheet');
home = replaceExact(home, 'src="/home.js"', 'src="/home.js?v=1.7.98-homepage-polish-1"', 'homepage script');
home = replaceExact(home, 'src="/live-chat.js"', 'src="/live-chat.js?v=1.7.98-homepage-polish-1"', 'live chat script');
